    {"name":"Get normalized records","request":{"method":"GET","url":"{{baseUrl}}/records"}},
    {"name":"Get sync status","request":{"method":"GET","url":"{{baseUrl}}/admin/sync/status"}},
    {"name":"Webhook example","request":{"method":"POST","url":"{{baseUrl}}/webhook/hubspot","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id\": \"hs-999\",\n  \"name\": \"Webhook contact\",\n  \"stage\": \"lead\"\n}"}}}
  ],
  "variable":[{"key":"baseUrl","value":"http://localhost:3000"}]
