{
  "info": {
    "_postman_id": "f3e2f276-5e9b-42e1-a7d9-f8f62d31cc60",
    "name": "Sync Pipeline Backend API",
    "description": "Comprehensive Postman collection for the resilient Multi-Source ETL Sync Pipeline (HubSpot CRM, Payments Processor, Google Calendar Events).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "15624865"
  },
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Check backend service health and operational status."
      },
      "response": []
    },
    {
      "name": "Seed Sample Data",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/seed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "seed"
          ]
        },
        "description": "Seed store with initial sample records across HubSpot, Payments, and Calendar."
      },
      "response": []
    },
    {
      "name": "Run Multi-Source Sync",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sources\": [\"hubspot\", \"payments\", \"calendar\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sync/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sync",
            "run"
          ]
        },
        "description": "Triggers multi-source ingestion. Automatically falls back to full backfill on 410/stale cursor and isolates failures per source."
      },
      "response": []
    },
    {
      "name": "Trigger Stale Cursor 410 Fallback",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sources\": [\"hubspot\", \"payments\", \"calendar\"],\n  \"forceStaleCursorFor\": [\"payments\", \"calendar\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sync/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sync",
            "run"
          ]
        },
        "description": "Simulates an expired 410 cursor on payments/calendar to verify automatic recovery and full backfill fallback."
      },
      "response": []
    },
    {
      "name": "Trigger Partial Failure Isolation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sources\": [\"hubspot\", \"payments\", \"calendar\"],\n  \"simulateErrorFor\": [\"hubspot\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sync/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sync",
            "run"
          ]
        },
        "description": "Simulates a 500/garbage error on HubSpot to verify that Payments and Calendar still land their data."
      },
      "response": []
    },
    {
      "name": "Get Normalized Records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/records",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "records"
          ]
        },
        "description": "Retrieves all ingested records in the unified normalized schema."
      },
      "response": []
    },
    {
      "name": "Get Sync Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/sync/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "sync",
            "status"
          ]
        },
        "description": "Returns current cursor timestamps, sync mode, last success time, and error states per source."
      },
      "response": []
    },
